{
  "name": "@tzyc/mmsc-workbench",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "DSH settings section for the MMSC modpack workbench: edits the workbench port and pack directory, starts/stops/restarts the local kjsftb ui server, and opens it in the browser.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "mmsc",
    "minecraft",
    "kubejs",
    "ftb-quests"
  ],
  "license": "MIT"
}
